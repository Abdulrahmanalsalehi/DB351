CREATE OR REPLACE TRIGGER VALIDATE_DEPARTMENT_CHAIR
BEFORE INSERT OR UPDATE ON DEPARTMENT
FOR EACH ROW
DECLARE
  V_COUNT NUMBER;
BEGIN
IF :NEW.CHAIR_ID IS NOT NULL THEN
  -- if the chair belong to the department count will be updated 
  SELECT COUNT(*) INTO V_COUNT
  FROM INSTRUCTOR I
  WHERE I.IID = :NEW.CHAIR_ID
  AND DID = :NEW.DID;
 
  IF V_COUNT = 0 THEN
     RAISE_APPLICATION_ERROR(-20002, 'INSTRUCTOR ' || :NEW.CHAIR_ID || ' DOES NOT BELONG TO DEPARTMENT ' || :NEW.DID);
  END IF;
END IF;
END;


   
