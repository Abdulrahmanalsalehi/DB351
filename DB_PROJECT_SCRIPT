-------------- DEPARTMENT --------------
CREATE TABLE DEPARTMENT(
 DID NUMBER,
 DNAME VARCHAR2(20) NOT NULL,
 OFFICE_LOCATION VARCHAR2(20),
 PHONE_NUMBER VARCHAR2(20) UNIQUE,
 CHAIR_ID NUMBER UNIQUE,
 CONSTRAINT PK_DID PRIMARY KEY (DID)
);

-------------- INSTRUCTOR --------------
CREATE TABLE INSTRUCTOR(
 IID NUMBER,
 INAME VARCHAR2(20) NOT NULL,
 EMAIL VARCHAR2(20) UNIQUE NOT NULL,
 PHONE_NUMBER VARCHAR2(20),
 HIRE_DATE DATE,
 DID NUMBER NOT NULL,
 CONSTRAINT PK_IID PRIMARY KEY (IID),
 CONSTRAINT FK_DID_INSTRUCTOR FOREIGN KEY (DID) REFERENCES DEPARTMENT(DID)
);


ALTER TABLE DEPARTMENT ADD CONSTRAINT FK_CHAIR
FOREIGN KEY(CHAIR_ID) REFERENCES INSTRUCTOR(IID);



-------------- STUDENT --------------
CREATE TABLE STUDENT(
 SID NUMBER,
 SNAME VARCHAR2(20) NOT NULL,
 EMAIL VARCHAR2(20) UNIQUE NOT NULL,
 DATE_OF_BIRTH DATE,
 GENDER VARCHAR2(1) CHECK (GENDER IN ('M','F')),
 ENROLLMENT_YEAR INT,
 DID NUMBER NOT NULL,
 ADVISOR_ID NUMBER NOT NULL, -- EACH STUDENT HAS ONE ADVISOR
 CONSTRAINT PK_SID PRIMARY KEY (SID),
 CONSTRAINT FK_DID_STUDENT FOREIGN KEY (DID) REFERENCES DEPARTMENT(DID),
 CONSTRAINT FK_ADVISOR_ID FOREIGN KEY (ADVISOR_ID) REFERENCES INSTRUCTOR(IID)
);


-------------- COURSE --------------
CREATE TABLE COURSE(
 CID NUMBER,
 CTITLE VARCHAR2(30) NOT NULL,
 CREDIT_HOURS NUMBER CHECK(CREDIT_HOURS > 0),
 DID NUMBER NOT NULL, -- EACH COURSE BELONGS TO ONE DEPRATMENT
 CONSTRAINT PK_CID PRIMARY KEY (CID),
 CONSTRAINT FK_DID_COURSE FOREIGN KEY (DID) REFERENCES DEPARTMENT(DID)
);

-------------- CLASSROOM --------------
CREATE TABLE CLASSROOM(
 RID NUMBER,
 RNUM VARCHAR2(30) NOT NULL,
 CAPACITY NUMBER CHECK(CAPACITY > 0),
 BUILDING_NAME VARCHAR2(30),
 CONSTRAINT PK_RID PRIMARY KEY (RID)
);


-------------- COURSE_SECTION --------------
CREATE TABLE COURSE_SECTION(
 SCID NUMBER,
 SCNUMBER NUMBER NOT NULL,
 CID NUMBER,
 IID NUMBER,
 RID NUMBER,
 SEMESTER VARCHAR2(30),
 YEAR NUMBER,
 DAY VARCHAR2(30),
 START_TIME VARCHAR2(30),
 END_TIME VARCHAR2(30),
 CONSTRAINT PK_SCID PRIMARY KEY (SCID),
 CONSTRAINT FK_CID_COURSE_SECTION FOREIGN KEY (CID) REFERENCES COURSE(CID),
 CONSTRAINT FK_IID_COURSE_SECTION FOREIGN KEY (IID) REFERENCES INSTRUCTOR(IID),
 CONSTRAINT FK_RID_COURSE_SECTION FOREIGN KEY (RID) REFERENCES CLASSROOM(RID)
);

-------------- EXAM --------------
CREATE TABLE EXAM(
 EID NUMBER,
 EXAM_TYPE VARCHAR2(20) CHECK(EXAM_TYPE IN ('MIDTERM','FINAL','QUIZ')),
 SCID NUMBER,
 EDATE DATE,
 MAX_MARKS INT CHECK (MAX_MARKS > 0),
 CONSTRAINT PK_EID PRIMARY KEY (EID),
 CONSTRAINT FK_SCID_EXAM FOREIGN KEY (SCID) REFERENCES COURSE_SECTION(SCID) -- AN EXAM BELONGS TO A SECTION
);
-------------- EXAM_RESULT --------------
CREATE TABLE EXAM_RESULT(
 SID NUMBER,
 SCID NUMBER,
 EID NUMBER,
 MARKS_OBTAINED NUMBER CHECK (MARKS_OBTAINED >= 0),
 CONSTRAINT PK_SID_EID PRIMARY KEY (SID, EID), -- LINK STUDENT TO THE EXAM RESULT
 CONSTRAINT FK_EID_EXAM_RESULT FOREIGN KEY (EID) REFERENCES EXAM(EID), --  BELONG TO AN EXAM
 CONSTRAINT FK_SID_EXAM_RESULT FOREIGN KEY (SID) REFERENCES STUDENT(SID), -- BELONG TO A STUDENT
 CONSTRAINT FK_SCID_EXAM_RESULT FOREIGN KEY (SCID) REFERENCES COURSE_SECTION(SCID) -- BELONG TO A COURSE_SECTION
);

-------------- STUDENT_COURSE_GRADE --------------
CREATE TABLE STUDENT_COURSE_GRADE(
 SID NUMBER,
 CID NUMBER,
 SCID NUMBER,
 STATUS VARCHAR2(10) CHECK (STATUS IN ('COMPLETED','DROPPED')),
 FINAL_GRADE VARCHAR2(2),
 CONSTRAINT PK_STUDENT_COURSE_GRADE PRIMARY KEY (SID, SCID), -- THIS TO PREVENT DUPLICATE OF GRADES OF THE SAME COURSE 
 CONSTRAINT FK_SID_GRADE FOREIGN KEY (SID) REFERENCES STUDENT(SID), -- BELONG TO A STUDENT
 CONSTRAINT FK_CID_GRADE FOREIGN KEY (CID) REFERENCES COURSE(CID), -- BELONG TO A COURSE
 CONSTRAINT FK_SCID FOREIGN KEY (SCID) REFERENCES COURSE_SECTION(SCID) -- BELONG TO A COURSE_SECTION
);




